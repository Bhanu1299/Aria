# Hotkey configuration
HOTKEY_KEY=space
HOTKEY_MODS=alt

# Timeouts
BROWSER_TIMEOUT=30

# LLM gateway — every LLM call in Aria goes through GateLLM (OpenAI-compatible).
# Provider API keys (Groq, Anthropic, OpenAI, ...) go in GateLLM's own .env, not here.
ARIA_GATEWAY_URL=http://127.0.0.1:8000

# Send every command to the agent (skip the zero-token direct routes): ARIA_FASTPATH=0

# Music app for media playback (default: "Music" = Apple Music)
# Change to "Spotify", "Tidal", etc. — must match the app name in /Applications
MUSIC_APP=Music

# Google (Gmail, Calendar, Sheets): one OAuth token, set up with `python -m aria.setup google`.
# Two Google accounts. GOOGLE_ACCOUNT = personal assistant (python -m aria.setup google);
# GOOGLE_JOBS_ACCOUNT = job pipeline: sheet + outreach drafts (python -m aria.setup google --account jobs).
GOOGLE_ACCOUNT=you@gmail.com
GOOGLE_JOBS_ACCOUNT=you.jobs@gmail.com

# Job sheet that feeds "apply to the next job". The ID is the long part of the sheet URL.
MUSE_SHEET_ID=your-spreadsheet-id
MUSE_SHEET_TAB=Sheet1
MUSE_APPLIED_TAB=Applied
MUSE_CONTACTS_TAB=Contacts
MUSE_COMPANIES_TAB=Companies

# Coldstart email finder (separate service; Aria calls POST $COLDSTART_URL/find).
# A local URL that's down is started from COLDSTART_DIR (COLDSTART_AUTOSTART=0 disables).
COLDSTART_URL=http://127.0.0.1:8765
COLDSTART_DIR=~/Documents/trae_projects/coldstart
# Seconds between Coldstart calls.
COLDSTART_MIN_INTERVAL=2
# Max contacts drafted per company (staggered by the Wave column).
CONTACTS_PER_COMPANY=3
# Contacts drafts are created only when the jobs Gmail account is this address
# (blank = GOOGLE_JOBS_ACCOUNT; neither set = no drafts).
OUTREACH_FROM=
# PDF attached to every Contacts draft (blank = resume_path from My answers).
OUTREACH_RESUME=
