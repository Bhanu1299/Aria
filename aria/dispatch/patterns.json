{
  "version": 1,
  "never": [
    "\\byoutube\\b",
    "\\b(?:and then|after that)\\b"
  ],
  "rules": [
    {"id": "music_pause", "tool": "music_pause", "params": {},
     "regex": "pause(?: the)?(?: music| song| playback)?|stop(?: the)? (?:music|song|playback)|stop playing(?: music)?"},
    {"id": "music_resume", "tool": "music_resume", "params": {},
     "regex": "(?:resume|unpause|play|continue)(?: the)?(?: music| playback| song)?|keep playing"},
    {"id": "music_skip", "tool": "music_skip", "params": {}, "priority": 60,
     "regex": "(?:skip|next)(?: this)?(?: song| track)?|(?:play )?(?:the )?next (?:song|track)"},
    {"id": "music_previous", "tool": "music_previous", "params": {}, "priority": 60,
     "regex": "previous(?: song| track)?|(?:go back|play the previous|play the last|last) (?:song|track)"},
    {"id": "music_now_playing", "tool": "music_now_playing", "params": {},
     "regex": "(?:what's|what is|whats) (?:this song|playing|this track|the song|the name of this song)(?: called)?|what song is (?:this|playing)|who sings this(?: song)?"},
    {"id": "music_play", "tool": "music_play", "params": {"query": "{query}"}, "priority": 40,
     "regex": "play (?!(?:a |the )?(?:video|game|podcast|audiobook|radio)\\b)(?P<query>[a-z0-9].{0,60}?)(?: on (?:spotify|apple music|music))?"},

    {"id": "volume_up", "tool": "system_control", "params": {"action": "volume_up"},
     "regex": "turn (?:it|the volume|volume|the sound) up|(?:volume|sound) up|louder|(?:increase|raise) (?:the )?volume"},
    {"id": "volume_down", "tool": "system_control", "params": {"action": "volume_down"},
     "regex": "turn (?:it|the volume|volume|the sound) down|(?:volume|sound) down|quieter|softer|(?:decrease|lower|reduce) (?:the )?volume"},
    {"id": "volume_set", "tool": "system_control", "params": {"action": "volume_set", "level": "{level:int}"},
     "regex": "(?:set (?:the )?volume to|volume to|volume|turn (?:the )?volume to) (?P<level>\\d{1,3})(?: percent|%)?"},
    {"id": "mute", "tool": "system_control", "params": {"action": "mute"},
     "regex": "mute(?: the)?(?: sound| volume| audio| mac| computer)?"},
    {"id": "unmute", "tool": "system_control", "params": {"action": "unmute"},
     "regex": "unmute(?: the)?(?: sound| volume| audio| mac| computer)?"},
    {"id": "brightness_up", "tool": "system_control", "params": {"action": "brightness_up"},
     "regex": "(?:turn (?:the )?brightness up|brightness up|brighter|(?:increase|raise) (?:the )?brightness|make (?:the screen|it) brighter)"},
    {"id": "brightness_down", "tool": "system_control", "params": {"action": "brightness_down"},
     "regex": "(?:turn (?:the )?brightness down|brightness down|dimmer|dim (?:the )?screen|(?:decrease|lower|reduce) (?:the )?brightness|make (?:the screen|it) (?:darker|dimmer))"},
    {"id": "dark_mode_on", "tool": "system_control", "params": {"action": "dark_mode_on"},
     "regex": "(?:turn on|enable|switch to|go to) dark mode|dark mode on"},
    {"id": "dark_mode_off", "tool": "system_control", "params": {"action": "dark_mode_off"},
     "regex": "(?:turn off|disable) dark mode|dark mode off|(?:turn on|enable|switch to|go to) light mode"},
    {"id": "dark_mode_toggle", "tool": "system_control", "params": {"action": "dark_mode_toggle"},
     "regex": "toggle dark mode"},
    {"id": "screenshot", "tool": "system_control", "params": {"action": "screenshot"},
     "regex": "(?:take a |take |grab a |capture a )?screen ?shot|(?:take a picture|capture) of (?:my|the) screen"},
    {"id": "lock_screen", "tool": "system_control", "params": {"action": "lock_screen"},
     "regex": "lock (?:my |the )?(?:mac|computer|screen|laptop)"},
    {"id": "wifi_on", "tool": "system_control", "params": {"action": "wifi_on"},
     "regex": "(?:turn|switch) on (?:the )?wi-?fi|(?:turn|switch) (?:the )?wi-?fi on|enable (?:the )?wi-?fi"},
    {"id": "wifi_off", "tool": "system_control", "params": {"action": "wifi_off"},
     "regex": "(?:turn|switch) off (?:the )?wi-?fi|(?:turn|switch) (?:the )?wi-?fi off|disable (?:the )?wi-?fi"},
    {"id": "bluetooth_on", "tool": "system_control", "params": {"action": "bluetooth_on"},
     "regex": "(?:turn|switch) on (?:the )?bluetooth|(?:turn|switch) (?:the )?bluetooth on|enable (?:the )?bluetooth"},
    {"id": "bluetooth_off", "tool": "system_control", "params": {"action": "bluetooth_off"},
     "regex": "(?:turn|switch) off (?:the )?bluetooth|(?:turn|switch) (?:the )?bluetooth off|disable (?:the )?bluetooth"},

    {"id": "app_open", "tool": "app", "params": {"app_name": "{app_name}"},
     "regex": "(?:open|launch) (?!my |the |a |an |this |that |it |up |new )(?!.*\\band\\b)(?!\\S*\\.\\S)(?P<app_name>[a-z0-9][a-z0-9 &'+-]{0,30})"},
    {"id": "app_quit", "tool": "system_control", "params": {"action": "quit_app", "app_name": "{app_name}"},
     "regex": "(?:quit|close|exit) (?!my |the |a |this |that |it |all |every |full ?screen)(?!.*\\band\\b)(?P<app_name>[a-z0-9][a-z0-9 &'+-]{0,30})"},

    {"id": "time_now", "tool": "clock", "params": {"what": "time"},
     "regex": "what time is it(?: now| right now)?|(?:what's|what is|whats) the time(?: now| right now)?|tell me the time|do you have the time|current time"},
    {"id": "date_today", "tool": "clock", "params": {"what": "date"},
     "regex": "(?:what's|what is|whats) (?:today's date|todays date|the date(?: today)?|today)|what day is (?:it|today)(?: today)?|what's the day today"},

    {"id": "calculate", "tool": "calculate", "params": {"expression": "{expression}"},
     "regex": "(?:what's|what is|whats|calculate|compute|how much is) (?P<expression>-?\\d[\\d,.]*(?:\\s*(?:\\+|-|\\*|x|×|/|÷|plus|minus|times|multiplied by|divided by|over|to the power of)\\s*-?\\d[\\d,.]*)+)"},
    {"id": "percent_of", "tool": "calculate", "params": {"expression": "{expression}"},
     "regex": "(?:what's|what is|whats|calculate|how much is) (?P<expression>\\d[\\d.]*(?:%| percent) of \\d[\\d,.]*)"},

    {"id": "timer_set", "tool": "timer_set", "params": {"seconds": "{duration:duration}", "label": "{label}"}, "priority": 55,
     "regex": "(?:set|start|create|make)(?: a| an| the)? timer (?:for|of) (?P<duration>.+?)(?: (?:called|named|for) (?P<label>[a-z][a-z ]{0,30}))?"},
    {"id": "timer_set_prefix", "tool": "timer_set", "params": {"seconds": "{duration:duration}", "label": "{label}"}, "priority": 55,
     "regex": "(?:set|start|create|make)(?: a| an)? (?P<duration>[a-z0-9 .-]+?) timer(?: (?:called|named|for) (?P<label>[a-z][a-z ]{0,30}))?"},
    {"id": "timer_short", "tool": "timer_set", "params": {"seconds": "{duration:duration}"}, "priority": 55,
     "regex": "timer (?:for )?(?P<duration>.+)"},
    {"id": "timer_status", "tool": "timer_status", "params": {}, "priority": 56,
     "regex": "how much time is left(?: on (?:the|my) (?:[a-z]+ )?timer)?|how long is left(?: on (?:the|my) (?:[a-z]+ )?timer)?|(?:check|show) (?:the |my )?timers?|timer status|how(?:'s| is) (?:the|my) timer"},
    {"id": "timer_cancel", "tool": "timer_cancel", "params": {"label": "{label}"}, "priority": 56,
     "regex": "(?:cancel|stop|delete|clear|turn off)(?: the| my| all| all the)?(?: (?P<label>(?!timer)[a-z]+))? timers?"},

    {"id": "reminder_when_first", "tool": "reminder_add", "params": {"due": "{when:when}", "task": "{task}"}, "priority": 61,
     "regex": "remind me (?P<when>(?:in|at|on|by|tomorrow|tonight|today|this|next) .+?) to (?P<task>.+)"},
    {"id": "reminder", "tool": "reminder_add", "params": {"*": "{rest:task_when}"}, "priority": 60,
     "regex": "remind me to (?P<rest>.+)"},
    {"id": "reminder_add", "tool": "reminder_add", "params": {"*": "{rest:task_when}"}, "priority": 60,
     "regex": "(?:add|create|set|make)(?: a| an)? reminder (?:to|for|that) (?P<rest>.+)"},
    {"id": "reminder_list_add", "tool": "reminder_add", "params": {"task": "{task}"}, "priority": 59,
     "regex": "add (?P<task>.+?) to (?:my )?(?:reminders|reminder list|to-?do list|todo list|to do list)"},

    {"id": "agenda", "tool": "agenda", "params": {"day": "{day}"},
     "regex": "(?:what's|what is|whats) on my (?:calendar|schedule|agenda)(?: for)?(?: (?P<day>today|tomorrow))?"},
    {"id": "agenda_have", "tool": "agenda", "params": {"day": "{day}"},
     "regex": "what (?:do i have|have i got|am i doing)(?: on)? (?P<day>today|tomorrow)"},
    {"id": "agenda_my", "tool": "agenda", "params": {"day": "{day}"},
     "regex": "(?:what's|what is|whats) my (?:schedule|agenda)(?: for)?(?: (?P<day>today|tomorrow))?"}
  ]
}
